# StyleScan backend (backend/server.js), which holds the OpenAI key.
# Copy this file to `.env` (do NOT commit that file).
# Use your computer's LAN IP while developing (macOS: `ipconfig getifaddr en0`);
# the phone must be on the same Wi-Fi. Read via react-native-config as
# Config.BACKEND_URL — rebuild the app (not just reload JS) after changing it.
# The OpenAI key itself goes in backend/.env (see backend/.env.example).
BACKEND_URL=http://192.168.1.10:3002

# Supabase Configuration
# Create a free project at https://supabase.com, then run supabase/schema.sql
# (SQL Editor tab) to create the profiles/scans tables.
# Find these values under Project Settings -> API.
# Read via react-native-config as Config.SUPABASE_URL / Config.SUPABASE_ANON_KEY
# — rebuild the app (not just reload JS) after changing this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
