# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Copy this file to `.env` (do NOT commit that file) and set your real key.
# Read via react-native-config as Config.OPENAI_API_KEY — rebuild the app
# (not just reload JS) after changing this file.
OPENAI_API_KEY=sk-your-actual-key-here

# Supabase Configuration
# Create a free project at https://supabase.com, then run supabase/schema.sql
# (SQL Editor tab) to create the profiles/scans tables.
# Find these values under Project Settings -> API.
# Read via react-native-config as Config.SUPABASE_URL / Config.SUPABASE_ANON_KEY
# — rebuild the app (not just reload JS) after changing this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
