{
  "root": true,
  "extends": "@react-native-community",
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "react-native/react-native": true,
    "es6": true
  },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "react-native/no-unused-styles": "warn"
  }
}
